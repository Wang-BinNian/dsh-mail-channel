{
  "name": "dsh-mail-channel",
  "version": "0.1.0",
  "description": "Email channel for DeepSeek Harness: mail tools, arrival wake-up, and channel health for agent-to-owner communication.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "email",
    "mail",
    "imap",
    "smtp",
    "agent",
    "channel"
  ],
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/**/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "test": "node test/mime.test.mjs && node test/security.test.mjs && node test/harness.mjs && node test/verify.test.mjs && node test/lock.test.mjs && node test/rotate.test.mjs && node test/client.test.mjs"
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/dsh": "^0.2.2-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "license": "MIT",
  "author": "世界散人",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
